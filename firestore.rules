rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/stores/$(storeId)) &&
             get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
             (request.auth.token.email == "info@adastranetwork.co.uk" ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == "info@adastranetwork.co.uk")));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalStamps', 'totalRedeemed', 'total_cards_held', 'totalSaved', 'lastStampAt', 'lastSeenAt', 'seenAnnouncementIds', 'vendorIntroComplete']));
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /vendors/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalStamps', 'totalRedeemed', 'total_cards_held']));
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAdmin() ||
        (isAuthenticated() && (resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == "system_seed") &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus', 'subscriptionId', 'subscriptionEnd', 'stripeCustomerId']));
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == "system_seed" || isAdmin());
      
      match /posts/{postId} {
        allow read: if true;
        allow create: if isAuthenticated() || isAdmin();
        allow update, delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isStoreOwner(storeId) || isAdmin());
      }

      match /broadcasts/{broadcastId} {
        allow read, create: if isAuthenticated() && isStoreOwner(storeId);
        allow delete: if isAuthenticated() && isStoreOwner(storeId);
      }
    }

    // Support collectionGroup queries for posts
    match /{path=**}/posts/{postId} {
      allow read: if true;
    }

    match /cards/{cardId} {
      // Allow authenticated users to read their own cards, or store owners to read cards for their store.
      // Allow reading non-archived cards for the leaderboard.
      allow read: if isAuthenticated() && (
        (resource == null) || 
        (request.auth.uid == resource.data.user_id) ||
        (isStoreOwner(resource.data.store_id)) ||
        (!('isArchived' in resource.data) || resource.data.isArchived == false) ||
        isAdmin()
      );
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isStoreOwner(resource.data.store_id) || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isStoreOwner(resource.data.store_id) || isAdmin());
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isStoreOwner(resource.data.store_id) || isAdmin());
      allow create: if isAuthenticated() || isAdmin();
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isStoreOwner(resource.data.store_id) || isAdmin());
    }

    match /user_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.fromUid == request.auth.uid || isAdmin());

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
      }

      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.followerUid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.followerUid == request.auth.uid || isAdmin());
    }

    match /global_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['pollVotes', 'likesCount', 'likedBy']) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (request.resource.data.fromUid == request.auth.uid || isAdmin());
        allow update: if isAuthenticated() && (
          resource.data.fromUid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy']) ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (resource.data.fromUid == request.auth.uid || isAdmin());
      }
    }

    match /store_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    match /store_follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.followerUid == request.auth.uid;
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids']));
    }

    match /challenge_entries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /sticker_cards/{cardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isAdmin());
    }

    match /sticker_wallets/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /user_stickers/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
      allow create: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
    }

    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.blockerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.blockerUid == request.auth.uid;
    }

    match /store_offers/{offerId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.storeId == request.auth.uid || isStoreOwner(resource.data.storeId) || isAdmin());
    }

    match /linqle/{dateId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();

      match /scores/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAdmin();
      }
    }

    match /linqle_alltime/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    match /offer_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStoreOwner(resource.data.storeId) || isAdmin());
      allow create: if isAuthenticated();
    }

    match /store_automations/{automationId} {
      allow read: if isAuthenticated() && (isStoreOwner(resource.data.storeId) || isAdmin());
      allow create: if isAuthenticated() && isStoreOwner(request.resource.data.storeId);
      allow update, delete: if isAuthenticated() && (isStoreOwner(resource.data.storeId) || isAdmin());
    }

    match /physical_cards/{cardId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /collectible_card_sets/{setId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /collectible_cards/{cardId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAuthenticated() && (resource.data.toUid == request.auth.uid || isAdmin());
    }

    match /daily_vote/{dateId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCounts', 'totalVotes', 'commentCount']));

      match /votes/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAdmin();
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    match /qr_tokens/{tokenId} {
      // Vendors write tokens; consumers read and claim (mark used) via transaction
      allow read, write: if isAuthenticated();
    }

    match /events/{eventId} {
      // Any authenticated user can append analytics events; only admin can read; owner can delete (account deletion)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /admin_gifs/{gifId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /collectible_card_defs/{defId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /app_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /leaderboard_pins/{pinId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.uids || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.uids || isAdmin());
      allow update: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.uids || isAdmin());

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.uids || isAdmin());
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.uids || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || isAdmin());
      }
    }
  }
}
