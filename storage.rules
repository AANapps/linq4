rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // All images are publicly readable (served via download URLs)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Store assets (stamp icons, charity images, etc.) — any authenticated vendor may upload
    match /stores/{storeId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Store logos — any authenticated user may upload (admins manage logos for stores they don't own)
    match /store_logos/{storeOrUid}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Offer images — any authenticated vendor may upload
    match /offer_images/{storeId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Challenge images — any authenticated user (admin) may upload
    match /challenge_images/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Collectible card images — admin only (20 MB to allow animated GIFs)
    match /collectible_cards/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Daily vote images — any authenticated user may upload
    match /daily_vote/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Banner images — admin only
    match /banner_images/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Admin FYP post images
    match /admin_posts/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // User post images — uploader must match the uid path segment
    match /user_posts/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
